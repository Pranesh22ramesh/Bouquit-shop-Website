NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_ENABLED=true
SUPABASE_STORAGE_BUCKET=site-assets
JWT_ACCESS_SECRET=replace-with-very-long-access-secret
JWT_REFRESH_SECRET=replace-with-very-long-refresh-secret
JWT_RESET_SECRET=replace-with-very-long-reset-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=bb_refresh_token
UPLOAD_DIR=uploads
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=3000
RATE_LIMIT_IPV6_SUBNET=56
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=200
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_ACCOUNT_ATTEMPT_MAX=3
RATE_LIMIT_AUTH_IP_ATTEMPT_MAX=10
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=1500
RATE_LIMIT_AUTH_BACKOFF_MAX_MS=60000
RATE_LIMIT_AUTH_ATTEMPT_MAP_MAX_ENTRIES=20000
RATE_LIMIT_SIGNUP_ACCOUNT_ATTEMPT_MAX=2
RATE_LIMIT_USER_WINDOW_MS=900000
RATE_LIMIT_USER_MAX=500
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=30
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_FILES_PER_REQUEST=8
UPLOAD_MAX_FIELDS_PER_REQUEST=40
UPLOAD_MAX_FIELD_BYTES=131072
UPLOAD_MAX_IMAGE_PIXELS=40000000
# Local server: 0. Set to the actual number of trusted proxy hops in deployment.
TRUST_PROXY_HOPS=0

# Production reset emails require a verified sender domain. Never use VITE_ for these.
RESEND_API_KEY=
MAIL_FROM=
BOOTSTRAP_ADMIN=false
CORS_ORIGINS=
STREAM_MAX_PER_USER=5
STREAM_MAX_TOTAL=1000
